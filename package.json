{
  "name": "opencli-agent",
  "version": "1.0.0",
  "description": "A CLI AI Agent powered by Yuanbao via OpenCLI browser automation",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "opencli-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cross-spawn": "^7.0.6",
    "ora": "^8.0.1",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=21.0.0"
  }
}
